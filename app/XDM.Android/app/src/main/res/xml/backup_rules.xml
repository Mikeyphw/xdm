    <exclude domain="database" path="xdm.db-shm" />
    <exclude domain="database" path="xdm.db-wal" />
    <exclude domain="file" path="checkpoints/" />
    <exclude domain="file" path="ownership/" />
    <exclude domain="file" path="journals/" />
    <exclude domain="file" path="recovery/" />
    <exclude domain="file" path="termux/" />
    <exclude domain="file" path="diagnostics/" />
    <exclude domain="file" path="support/" />
    <exclude domain="sharedpref" path="androidx.work.util.preferences.xml" />
</full-backup-content>
