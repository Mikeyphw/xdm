<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Cloud backup must never preserve credentials, signed URLs, Room state, checkpoints, ownership, Termux handoffs, diagnostics, or recovery commands. -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="database" path="xdm.db" />
        <exclude domain="database" path="xdm.db-shm" />
        <exclude domain="database" path="xdm.db-wal" />
        <exclude domain="file" path="checkpoints/" />
        <exclude domain="file" path="ownership/" />
        <exclude domain="file" path="journals/" />
        <exclude domain="file" path="recovery/" />
        <exclude domain="file" path="termux/" />
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="file" path="support/" />
        <exclude domain="sharedpref" path="androidx.work.util.preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfer is separately denied because allowBackup=false is not enough on every Android/OEM path. -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="database" path="xdm.db" />
        <exclude domain="database" path="xdm.db-shm" />
        <exclude domain="database" path="xdm.db-wal" />
        <exclude domain="file" path="checkpoints/" />
        <exclude domain="file" path="ownership/" />
        <exclude domain="file" path="journals/" />
        <exclude domain="file" path="recovery/" />
        <exclude domain="file" path="termux/" />
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="file" path="support/" />
        <exclude domain="sharedpref" path="androidx.work.util.preferences.xml" />
    </device-transfer>
</data-extraction-rules>
