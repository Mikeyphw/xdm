  "category": "import",
  "derivation": {
    "behavior": "Legacy imports are journaled, idempotent and restart-safe without permanent dual-write.",
    "canonical_behavior": "Go import framework records source kind/version/hash/status, stages objects before final commit, rejects unsupported newer sources before mutation and supports duplicate imports, crash recovery and retry after failure for Android Room/Desktop JSON adapters.",
    "strategy": "redesign"
  },
  "donor_ids": [
    "android_database",
    "desktop_download_manager"
  ],
  "expected": {
    "idempotency_key": "source_kind/version/source_hash",
    "invariants": [
      "Each import journal record includes source kind, source version, source hash, status and committed count.",
      "The idempotency key is source kind plus version plus source hash.",
      "Duplicate import returns the committed journal result without creating new authoritative objects.",
      "Crash after staging leaves staged objects recoverable but does not mutate authoritative state before restart.",
      "Malformed input and unsupported newer source versions do not create authoritative mutations.",
      "A failed import can be retried and committed with the same idempotency key."
    ],
    "journal_fields": [
      "source_kind",
      "source_version",
      "source_hash",
      "status",
      "staged_count",
      "committed_count"
    ],
    "no_permanent_dual_write": true,
    "unsupported_newer_source_mutates_authoritative_state": false
  },
  "fixture_id": "xgo-cap-ops-005",
